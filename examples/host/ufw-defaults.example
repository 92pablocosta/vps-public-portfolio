# -----------------------------------------------------------------------------
# EXAMPLE — sanitized, educational.
#
# UFW default policy: /etc/default/ufw
#
# READ THIS FIRST: this file is NOT the firewall ruleset. It sets default
# policies and framework behaviour. It does not prove that 22, 80, or 443 are
# allowed, it does not list any rule, and it does not capture Docker-managed
# packet filtering — which bypasses UFW's own chains entirely.
#
# The effective state must be read from the live system:
#   sudo ufw status verbose
#   sudo iptables  -S
#   sudo ip6tables -S
# -----------------------------------------------------------------------------

# Govern IPv6 explicitly rather than leaving it unexamined. A dual-stack host
# with a hardened IPv4 posture and an unreviewed IPv6 posture is a host with an
# unreviewed posture. IPv4 and IPv6 were audited separately here.
IPV6=yes

# Deny by default; allow only the three public services explicitly.
DEFAULT_INPUT_POLICY="DROP"
DEFAULT_OUTPUT_POLICY="ACCEPT"

# This host is not a router. Docker still enables net.ipv4.ip_forward at runtime
# for bridge networking and manages its own FORWARD chains; the UFW-level
# default stays DROP.
DEFAULT_FORWARD_POLICY="DROP"

DEFAULT_APPLICATION_POLICY="SKIP"

# Leave UFW to its own chains. Setting this to "yes" breaks rules managed
# outside UFW — including Docker's.
MANAGE_BUILTINS=no

IPT_SYSCTL=/etc/ufw/sysctl.conf

# -----------------------------------------------------------------------------
# The rules themselves, applied separately:
#
#   sudo ufw default deny incoming
#   sudo ufw default allow outgoing
#   sudo ufw allow 22/tcp          # SSH  — key-only, Fail2ban jail
#   sudo ufw allow 80/tcp          # ACME challenge + redirect to HTTPS
#   sudo ufw allow 443/tcp         # HTTPS via the reverse proxy
#   sudo ufw enable
#
# ALWAYS allow SSH before enabling. Enabling a default-deny firewall over an SSH
# session without an allow rule for it terminates your only access path, and the
# rollback requires provider console access.
# -----------------------------------------------------------------------------
